{
  "name": "realtime-incident-os",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace worker\" \"npm run dev --workspace client\"",
    "test": "npm run test --workspace shared",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "workspaces": [
    "client",
    "server",
    "worker",
    "shared"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}

